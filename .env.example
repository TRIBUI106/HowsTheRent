# Backend deploy/runtime env
# Copy these values to Render Environment Variables, then replace placeholders with real values.

# Database: Neon/Supabase Postgres
DB_URL=jdbc:postgresql://<postgres-host>/<database>?sslmode=require
DB_USER=<postgres-user>
DB_PASSWORD=<postgres-password>

# Password reset OTP is stored in backend memory for demo deploy.
# Redis is not required.

# JWT (generate with: openssl rand -base64 64)
JWT_SECRET=<long-random-jwt-secret>

# Mail SMTP (required for forgot-password OTP email)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<smtp-email>
MAIL_PASSWORD=<smtp-app-password>

# Cloudflare R2 / S3-compatible object storage
# R2 S3 API endpoint format: https://<account-id>.r2.cloudflarestorage.com
# MINIO_PUBLIC_URL should be your R2 custom domain or public r2.dev bucket URL.
MINIO_URL=https://<account-id>.r2.cloudflarestorage.com
MINIO_PUBLIC_URL=https://<public-r2-domain-or-r2-dev-url>
MINIO_ACCESS_KEY=<r2-access-key>
MINIO_SECRET_KEY=<r2-secret-key>
MINIO_BUCKET=htr
MINIO_AUTO_CREATE_BUCKET=false

# Frontend / CORS / Cookies
# Use your real Vercel production URL here.
CORS_ALLOWED_ORIGINS=https://htr-frontend-erlx0nupo-tribui106s-projects.vercel.app
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax

# PayOS
PAYOS_CLIENT_ID=<payos-client-id>
PAYOS_API_KEY=<payos-api-key>
PAYOS_CHECKSUM_KEY=<payos-checksum-key>
PAYOS_RETURN_URL=https://htr-frontend-erlx0nupo-tribui106s-projects.vercel.app/payment/success
PAYOS_CANCEL_URL=https://htr-frontend-erlx0nupo-tribui106s-projects.vercel.app/payment/cancel

# Server
# Render provides PORT automatically. Local dev can use SERVER_PORT.
SERVER_PORT=8080
