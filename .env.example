# Backend
DB_URL=jdbc:postgresql://localhost:5432/htr
DB_USER=htr
DB_PASSWORD=secret

# Password reset OTP is stored in backend memory for this demo deploy.
# No Redis service is required.

# JWT (generate: openssl rand -base64 64)
JWT_SECRET=changeThisToASecureRandomStringAtLeast256BitsLong!!

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Object storage (MinIO locally, Cloudflare R2 in production)
# Cloudflare R2 example:
# MINIO_URL=https://<account-id>.r2.cloudflarestorage.com
# MINIO_PUBLIC_URL=https://<public-r2-domain>
# MINIO_AUTO_CREATE_BUCKET=false
MINIO_URL=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000/htr
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=htr
MINIO_AUTO_CREATE_BUCKET=true

# Frontend / CORS / Cookies
# Local dev defaults are OK. For deploy with Vercel rewrite /api -> Render, use:
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# PayOS
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
PAYOS_RETURN_URL=http://localhost:5173/payment/success
PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel

# Server
# Render provides PORT automatically. Local dev can use SERVER_PORT.
SERVER_PORT=8080
